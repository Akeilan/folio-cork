[Desktop Entry]
Type=Application
Name=Folio Show
GenericName=Presentations
Comment=Make slides and present them
Exec=folio-show %F
Icon=folio-show
Terminal=false
Categories=Office;Presentation;
MimeType=application/vnd.openxmlformats-officedocument.presentationml.presentation;application/vnd.ms-powerpoint;
Keywords=slides;presentation;deck;pptx;talk;
StartupWMClass=folio-show
Actions=new-window;

[Desktop Action new-window]
Name=New Presentation
Exec=folio-show
